# DentaSense AI — Environment Variables Example
# Copy this file to .env.local and populate the secrets as needed.

# --------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Configuration
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is STRICTLY server-side. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------------------
# 2. Vision Analysis AI Provider
# --------------------------------------------------------------------
# Real vision provider for oral photograph analysis.
# If omitted, DentaSense runs in explicitly labelled Simulated Dev Mode.
VISION_PROVIDER_API_KEY=
VISION_PROVIDER_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 3. Conversational / Text AI Provider
# --------------------------------------------------------------------
# Real text model for adaptive interview follow-up questions.
TEXT_PROVIDER_API_KEY=
TEXT_PROVIDER_MODEL=gemini-1.5-flash

# --------------------------------------------------------------------
# 4. Speech Provider (STT & TTS)
# --------------------------------------------------------------------
# Default: Web Speech API runs client-side in the browser for English & Hindi.
# Optional cloud speech integration:
SPEECH_PROVIDER_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
TEXT_TO_SPEECH_MODEL=tts-1

# --------------------------------------------------------------------
# 5. Application URL
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
